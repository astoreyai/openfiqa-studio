# Unredacted discovery notes — reference a repository that is not publicly released
docs/discovery/internal/

# Biometric data — never commit
datasets/
data/
images/
samples/
*.jpg
*.jpeg
*.png
*.bmp
*.tif
*.tiff

# Models and checkpoints
models/
checkpoints/
*.pt
*.pth
*.onnx
*.safetensors

# Run outputs and artifacts
runs/
artifacts/
outputs/
mlruns/
*.parquet
*.duckdb
*.sqlite
*.sqlite3
*.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node / Tauri
node_modules/
.vite/
# NOT `src-tauri/target/` — a pattern containing a slash is anchored to this file's directory, so
# it would only have matched <repo>/src-tauri/target and missed apps/desktop/src-tauri/target,
# leaving 1.1 GB of build artifacts staged for a public repo.
**/src-tauri/target/
target/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Backend runtime state (SQLite projects, artifacts)
var/

# Local Claude Code settings
.claude/

# App icon is a design asset, not biometric data — allow it past the blanket image block
!apps/desktop/src-tauri/icons/
!apps/desktop/src-tauri/icons/*.png
**/src-tauri/gen/

# Machine-specific engine paths (one source repo is not publicly released)
config/local-paths.yaml

# Workflow run outputs
var/wf/
var/sweep/
var/runs/
